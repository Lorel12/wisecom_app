# Base de données — SQLite par défaut (fichier local, zéro configuration).
# Pour passer en PostgreSQL : changer datasource.provider dans prisma/schema.prisma
# puis DATABASE_URL="postgresql://user:password@localhost:5432/boutique_yde?schema=public"
DATABASE_URL="file:./dev.db"

# Serveur
PORT=4000
CLIENT_ORIGIN="http://localhost:3000"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="boutique_session"

# Destinataire du formulaire de contact du site
CONTACT_EMAIL="lorelngoumi@gmail.com"

# Compte super-admin créé automatiquement au premier démarrage (seed)
SUPERADMIN_EMAIL="admin@wisecom.cm"
SUPERADMIN_PASSWORD="ChangeMoiRapidement!123"
SUPERADMIN_FIRSTNAME="Admin"
SUPERADMIN_LASTNAME="Principal"

# Orange Money (Cameroun) — https://developer.orange.com/apis/om-webpay
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""
ORANGE_MONEY_API_BASE="https://api.orange.com"

# MTN MoMo (Collection API) — https://momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=""
MOMO_API_USER=""
MOMO_API_KEY=""
MOMO_TARGET_ENVIRONMENT="sandbox"
MOMO_API_BASE="https://sandbox.momodeveloper.mtn.com"

# Envoi d'e-mails (formulaire de contact et mot de passe oublié).
# Pour Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=votre adresse Gmail,
# SMTP_PASSWORD=mot de passe d'application Google et MAIL_FROM avec la même adresse.
# Sans SMTP_HOST, le formulaire propose un lien mailto au lieu d'indiquer un faux succès.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="WISECOM Global Trading and Supplies <no-reply@wisecom.cm>"
